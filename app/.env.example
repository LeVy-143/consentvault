# Copy to .env; replace placeholders locally. Never paste credentials in chat.
PORT=<API_PORT>
HOST=<API_BIND_ADDRESS>
APP_ORIGIN=<BROWSER_ORIGIN>
TIDECLOAK_CONFIG=<PATH_TO_DOWNLOADED_PUBLIC_ADAPTER_JSON>
DATABASE_PATH=<SQLITE_DATABASE_PATH>
# Bootstrap only, entered securely on your machine; never sent to app clients.
TIDECLOAK_URL=<REACHABLE_TIDECLOAK_BASE_URL>
REALM_NAME=<NEW_REALM_NAME>
CLIENT_NAME=<CONSENTVAULT_CLIENT_ID>
TIDE_LICENSE_EMAIL=<LICENCE_EMAIL_CHOSEN_BY_OWNER>
TIDE_TERMS_ACCEPTED=<YES_ONLY_AFTER_OWNER_AGREES_TO_HTTPS_TIDE_ORG_LEGAL>
KC_BOOTSTRAP_ADMIN_USERNAME=<BOOTSTRAP_ADMIN_USERNAME>
KC_BOOTSTRAP_ADMIN_PASSWORD=<ENTER_SECURELY_LOCAL_OR_ENVIRONMENT_SETTINGS>
